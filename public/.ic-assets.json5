[
  {
    "match": "**/*",
    "security_policy": "standard",
    "allow_raw_access": false,
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      "Referrer-Policy": "no-referrer",
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://icp-api.io https://*.icp-api.io https://icp0.io https://*.icp0.io https://ic0.app https://*.ic0.app; frame-src https://id.ai https://identity.ic0.app; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  {
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  {
    "match": ".well-known",
    "ignore": false
  },
  {
    "match": ".well-known/ic-architecture",
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    }
  },
  {
    "match": ".well-known/ii-derivation-origin",
    "headers": {
      "Content-Type": "text/plain; charset=utf-8"
    }
  }
]
